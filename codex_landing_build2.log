-const EJEMPLO = {"analysis": {"traffic_light": "potential", "confidence": "low", "label": "Potencial observado", "score": 48, "criterion": "Estimación por la estructura del video: no tenemos datos de alcance. Sube la foto de tus estadísticas para medir resultados reales.", "reasons": ["La comparación entre dos casos opuestos facilita entender el valor del servicio.", "El llamado final a la acción con una palabra específica es claro y fácil de responder."], "gaps": ["El inicio es lento y no promete una solución rápida en los primeros segundos.", "El video es demasiado largo para el formato y se apoya en imágenes poco auténticas."]}, "dna": {"schema_version": "1.0", "duration_seconds": 120, "language": "es", "summary": "El autor relata la historia comparativa de dos empresarios: uno que adoptó inteligencia artificial y redujo costos con más tiempo libre, frente a otro saturado de gastos. Finaliza invitando a comentar para recibir una auditoría.", "hook": {"end_second": 3, "spoken": "Hoy tuve la oportunidad de reunirme con Carlos y Esteban.", "on_screen": "HOY", "visual": "Hombre con gorra y lentes hablando en modo selfie en un patio."}, "structure": [{"start": 0, "end": 5.5, "role": "hook", "visual": "Hombre hablando a cámara con texto 'HOY' arriba.", "shot": "primer plano", "spoken": "Hoy tuve la oportunidad de reunirme con Carlos y Esteban. Carlos lleva más de un año aplicando la inteligencia artificial,", "on_screen": "HOY", "edit": "Corte inicial en selfie con subtítulos animados."}, {"start": 5.5, "end": 10.5, "role": "context", "visual": "Imagen de apoyo de un profesional frente a pantallas con gráficos.", "shot": "plano medio", "spoken": "automatizando cada uno de sus sistemas y haciéndolo subir al siguiente nivel.", "on_screen": null, "edit": "Inserción de imagen gráfica de apoyo a pantalla completa."}, {"start": 10.5, "end": 18.5, "role": "context", "visual": "Hombre hablando a cámara en el patio.", "shot": "primer plano", "spoken": "Esteban, pues él no ha podido, está muy ocupado y no ha hecho nada.", "on_screen": null, "edit": "Corte de regreso al presentador."}, {"start": 18.5, "end": 27.5, "role": "development", "visual": "Presentador hablando en otro ángulo exterior junto a una piscina y palmeras.", "shot": "primer plano", "spoken": "Ambos tuvieron casi que las mismas ventas del año pasado. Carlos este año ha triplicado las ventas,", "on_screen": null, "edit": "Cambio de locación visual."}, {"start": 27.5, "end": 30.5, "role": "development", "visual": "Gráfico azul con círculo central indicando '3x'.", "shot": "gráfico", "spoken": "Esteban también las ha triplicado,", "on_screen": "3x", "edit": "Corte a placa gráfica animada."}, {"start": 30.5, "end": 50.5, "role": "development", "visual": "Presentador explicando con apoyo visual inferior de hombre con computadora.", "shot": "primer plano con ventana gráfica", "spoken": "pero la diferencia entre uno y el otro es que Carlos gasta menos dinero para poder producir más, y a Esteban le toca gastar más dinero y su margen de utilidad es un poco menor debido a que le tocó contratar más personas para poder cubrir la demanda, mientras que Carlos simplemente con las automatizaciones", "on_screen": null, "edit": "Corte e inserción de imagen de apoyo circular."}, {"start": 50.5, "end": 54.5, "role": "development", "visual": "Ventana gráfica de mujer frente a pantalla de métricas sobre la toma del orador.", "shot": "primer plano con ventana gráfica", "spoken": "no fue necesario contratar varias personas, simplemente potenció las que ya tenía", "on_screen": null, "edit": "Inserción de gráfico semicircular."}, {"start": 54.5, "end": 102.5, "role": "development", "visual": "Presentador detallando los días de vacaciones con corte a imagen de familia en playa.", "shot": "primer plano con inserción", "spoken": "y la automatización hizo el resto. La otra diferencia es que Carlos duró 15 días de vacaciones con su familia, mientras que Esteban 3 días.", "on_screen": null, "edit": "Corte e imagen de familia en la playa."}, {"start": 102.5, "end": 111.5, "role": "turn", "visual": "Placa gris con círculo central mostrando al orador y texto 'SENCILLO LA IA ME AYUDA'.", "shot": "gráfico centrado", "spoken": "Entonces Esteban le pregunta a Carlos cómo lo hace, y él dijo: 'Sencillo, la IA me ayuda'.", "on_screen": "SENCILLO LA IA ME AYUDA", "edit": "Corte a placa gráfica con máscara circular."}, {"start": 111.5, "end": 141, "role": "reframe", "visual": "Presentador reflexionando en exteriores con inserción gráfica intermedia sobre el comercio.", "shot": "primer plano", "spoken": "Entonces el problema no es que tengas ventas, el problema es que no sabes cómo controlarlo, y la automatización es la inteligencia artificial te ayuda a poder controlarlo. Y esto me lleva a la siguiente reflexión: ¿de qué lado de la mesa te encuentras tú? ¿En la correcta o en la incorrecta? Porque Esteban definitivamente está en el lado incorrecto. La IA no vino a sustituir a las personas, la IA vino a mejorar las empresas, vino a mejorar al comerciante, vino a mejorar al emprendedor.", "on_screen": null, "edit": "Corte de plano y placa azul intermedia."}, {"start": 141, "end": 160, "role": "cta", "visual": "Presentador señalando a la pantalla y mostrando animación de teclado de teléfono.", "shot": "primer plano", "spoken": "Soy Jimmy Rengifo, contador público. Con inteligencia artificial te hago un diagnóstico, descubro tu fuga y te la soluciono. Escribe 'fuga' aquí y te mando mi agente para que analice tu caso y determine cuánto dinero estás perdiendo al mes. Es gratis. Escribe 'fuga'. Bye.", "on_screen": "fuga", "edit": "Corte a animación de chat y llamado final a la acción."}], "turn": {"second": 107, "description": "Revela la clave del contraste entre ambos casos: el uso de automatización con inteligencia artificial."}, "cta": {"start_second": 149, "type": "comment", "text": "Escribe 'fuga' aquí y te mando mi agente para que analice tu caso."}, "pacing": {"cuts": 11, "cuts_per_10s": 0.92}, "transcript": [{"start": 0, "end": 5.5, "text": "Hoy tuve la oportunidad de reunirme con Carlos y Esteban. Carlos lleva más de un año aplicando la inteligencia artificial,"}, {"start": 5.5, "end": 10.5, "text": "automatizando cada uno de sus sistemas y haciéndolo subir al siguiente nivel."}, {"start": 10.5, "end": 18.5, "text": "Esteban, pues él no ha podido, está muy ocupado y no ha hecho nada."}, {"start": 18.5, "end": 27.5, "text": "Ambos tuvieron casi que las mismas ventas del año pasado. Carlos este año ha triplicado las ventas,"}, {"start": 27.5, "end": 34, "text": "Esteban también las ha triplicado, pero la diferencia entre uno y el otro"}, {"start": 34, "end": 44, "text": "es que Carlos gasta menos dinero para poder producir más, y a Esteban le toca gastar más dinero y su margen de utilidad es un poco menor"}, {"start": 44, "end": 54, "text": "debido a que le tocó contratar más personas para poder cubrir la demanda, mientras que Carlos simplemente con las automatizaciones no fue necesario contratar varias personas,"}, {"start": 54, "end": 62, "text": "simplemente potenció las que ya tenía y la automatización hizo el resto."}, {"start": 62, "end": 106, "text": "La otra diferencia es que Carlos duró 15 días de vacaciones con su familia, mientras que Esteban 3 días."}, {"start": 106, "end": 112, "text": "Entonces Esteban le pregunta a Carlos cómo lo hace, y él dijo: 'Sencillo, la IA me ayuda'."}, {"start": 112, "end": 125, "text": "Entonces el problema no es que tengas ventas, el problema es que no sabes cómo controlarlo, y la automatización es la inteligencia artificial te ayuda a poder controlarlo."}, {"start": 125, "end": 141, "text": "Y esto me lleva a la siguiente reflexión: ¿de qué lado de la mesa te encuentras tú? ¿En la correcta o en la incorrecta? Porque Esteban definitivamente está en el lado incorrecto. La IA no vino a sustituir a las personas, la IA vino a mejorar las empresas, vino a mejorar al comerciante, vino a mejorar al emprendedor."}, {"start": 141, "end": 160, "text": "Soy Jimmy Rengifo, contador público. Con inteligencia artificial te hago un diagnóstico, descubro tu fuga y te la soluciono. Escribe 'fuga' aquí y te mando mi agente para que analice tu caso y determine cuánto dinero estás perdiendo al mes. Es gratis. Escribe 'fuga'. Bye."}], "evidence_notes": ["Interacciones registradas: 50 me gusta y 7 comentarios.", "El video dura dos minutos completos con narración en primera persona e inserciones gráficas."], "insights_read": {"shares": null, "saves": null, "average_watch_seconds": null, "completion_rate": null}, "signals": {"hook": {"score": 4, "fix": "Empieza con el beneficio directo o la pérdida de dinero antes del segundo tres en lugar de decir 'Hoy me reuní con...'."}, "proof": {"score": 5, "fix": "Muestra números reales de ahorro o capturas del sistema en vez de solo fotos genéricas de archivo."}, "pacing": {"score": 4, "fix": "Recorta la narración a menos de 60 segundos eliminando pausas y repeticiones del relato."}, "shareability": {"score": 4, "fix": "Añade un consejo práctico inmediato que la persona pueda aplicar o compartir con su socio hoy mismo."}, "cta": {"score": 7, "fix": "Mantén la palabra clave clara pero adelanta el llamado a la acción para que no quede al final de dos minutos."}}, "model_assessment": {"strengths": ["La comparación entre dos casos opuestos facilita entender el valor del servicio.", "El llamado final a la acción con una palabra específica es claro y fácil de responder."], "gaps": ["El inicio es lento y no promete una solución rápida en los primeros segundos.", "El video es demasiado largo para el formato y se apoya en imágenes poco auténticas."], "execution_score": 48}}, "versions": [{"id": "v1_error_comparacion", "angle": "Comparación entre una crema ligera común y una crema nutritiva densa para la noche", "hook": "El error de usar cremas ligeras de día cuando tu piel necesita nutrición profunda de noche", "technique": "Demostración comparativa en manos", "hook_type": "error_comun", "why_it_works": "Muestra la diferencia física de texturas en los primeros segundos, reteniendo a quien siente su piel seca al despertar y facilitando la decisión de compra.", "share_trigger": "Se lo envían a amigas o familiares que siempre se quejan de levantarse con la cara tirante o reseca.", "save_trigger": "Guardan el video para recordar cómo revisar la consistencia y los ingredientes antes de comprar una crema.", "script": [{"start": 0, "end": 4, "voice": "Si te despiertas con la piel tirante, estás cometiendo este error con tu crema.", "on_screen": "Tu crema de noche no hidrata bien"}, {"start": 4, "end": 9, "voice": "Muchas cremas comunes tienen demasiada agua y se evaporan a las dos horas de dormir.", "on_screen": "Se evapora mientras duermes"}, {"start": 9, "end": 15, "voice": "Mira esta crema común: se siente fresca al inicio, pero desaparece sin dejar una barrera real.", "on_screen": "Crema común: poca nutrición"}, {"start": 15, "end": 22, "voice": "En cambio, una fórmula diseñada para piel madura como [nombre de tu crema] tiene otra densidad.", "on_screen": "Fórmula rica para piel madura"}, {"start": 22, "end": 29, "voice": "Al aplicarla, notas de inmediato cómo sella la humedad gracias a [tu ingrediente clave].", "on_screen": "Sella la hidratación profunda"}, {"start": 29, "end": 37, "voice": "No deja sensación grasosa, pero crea un manto protector que trabaja durante toda la noche.", "on_screen": "Nutre sin dejar brillo grasoso"}, {"start": 37, "end": 44, "voice": "Al despertar, la piel se siente suave, elástica y descansada, no acartonada.", "on_screen": "Piel suave y flexible al despertar"}, {"start": 44, "end": 52, "voice": "Esto le sirve a cualquiera que sienta que sus cremas de siempre ya no le hacen nada.", "on_screen": "Comparte con quien use crema"}, {"start": 52, "end": 60, "voice": "Escríbeme NOCHE por mensaje directo y te paso el precio y cómo pedir la tuya hoy mismo.", "on_screen": "Escribe NOCHE por mensaje privado"}], "shooting_plan": [{"start": 0, "end": 4, "location": "Mesa de tocador en casa con luz natural frontal", "shot": "Plano cenital, celular apuntando verticalmente hacia la mesa", "action": "Coloca las dos manos sobre la mesa mostrando los dos frascos cerrados.", "on_screen": "Tu crema de noche no hidrata bien"}, {"start": 4, "end": 9, "location": "Mesa de tocador en casa", "shot": "Plano detalle de las manos", "action": "Abre el frasco de crema ligera y toma una gota pequeña.", "on_screen": "Se evapora mientras duermes"}, {"start": 9, "end": 15, "location": "Mesa de tocador en casa", "shot": "Plano detalle sobre el dorso de la mano izquierda", "action": "Esparce la crema ligera; se ve acuosa y desaparece rápido.", "on_screen": "Crema común: poca nutrición"}, {"start": 15, "end": 22, "location": "Mesa de tocador en casa", "shot": "Plano detalle cambiando al frasco de [nombre de tu crema]", "action": "Abre el frasco de [nombre de tu crema] y muestra su textura cremosa y firme.", "on_screen": "Fórmula rica para piel madura"}, {"start": 22, "end": 29, "location": "Mesa de tocador en casa", "shot": "Plano detalle sobre el dorso de la mano derecha", "action": "Aplica una porción de [nombre de tu crema] y realiza un masaje circular suave.", "on_screen": "Sella la hidratación profunda"}, {"start": 29, "end": 37, "location": "Mesa de tocador en casa", "shot": "Plano cerrado inclinando la mano hacia la luz", "action": "Muestra el acabado hidratado y aterciopelado de la piel.", "on_screen": "Nutre sin dejar brillo grasoso"}, {"start": 37, "end": 44, "location": "Mesa de tocador en casa", "shot": "Plano comparativo con ambas manos juntas", "action": "Pone ambas manos lado a lado para contrastar la mano opaca contra la mano nutrida.", "on_screen": "Piel suave y flexible al despertar"}, {"start": 44, "end": 52, "location": "Mesa de tocador en casa", "shot": "Plano medio de las manos sosteniendo el frasco principal", "action": "Sostiene el envase de [nombre de tu crema] con ambas manos en el centro.", "on_screen": "Comparte con quien use crema"}, {"start": 52, "end": 60, "location": "Mesa de tocador en casa", "shot": "Plano detalle del producto con fondo limpio", "action": "Muestra la tapa y etiqueta del producto señalando con un dedo.", "on_screen": "Escribe NOCHE por mensaje privado"}], "caption": "¿Te levantas con la piel tirante y sientes que tu crema no dura nada? La piel madura necesita retener humedad durante las horas de sueño. Escríbeme NOCHE por mensaje directo y te envío toda la información y el precio de [nombre de tu crema]. #CuidadoDeLaPiel #PielMadura #RutinaNocturna #HidratacionFacial"}, {"id": "v2_prueba_absorcion", "angle": "Demostración de absorción y suavidad inmediata sin sensación pesada", "hook": "La prueba rápida para saber si tu crema nutre de verdad o solo se queda en la superficie", "technique": "Prueba del resultado y textura", "hook_type": "resultado_visible_ya", "why_it_works": "La prueba visual con la textura engancha de inmediato porque resuelve el mayor temor de las personas: las cremas grasosas y pesadas.", "share_trigger": "Se lo mandan a personas que evitan ponerse crema de noche porque les molesta manchar la almohada.", "save_trigger": "Guardan la técnica de aplicación nocturna para replicarla en su rutina diaria.", "script": [{"start": 0, "end": 4, "voice": "Mira lo que pasa cuando aplicas una crema con verdadera nutrición nocturna.", "on_screen": "Así debe absorber tu crema nocturna"}, {"start": 4, "end": 10, "voice": "Muchas personas dejan de cuidarse de noche porque odian la sensación pegajosa en la almohada.", "on_screen": "Cero sensación grasosa o pegajosa"}, {"start": 10, "end": 17, "voice": "Tomamos solo esta cantidad de [nombre de tu crema]. La textura es densa pero suave.", "on_screen": "Solo necesitas una pequeña porción"}, {"start": 17, "end": 24, "voice": "Al masajear sobre la piel limpia, se funde en menos de treinta segundos.", "on_screen": "Se funde rápido en la piel"}, {"st