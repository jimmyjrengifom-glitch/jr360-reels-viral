+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
+  <title>Multiplicador de Reels — 3 guiones listos para grabar</title>
+  <meta name="description" content="Convierte un video que funcionó en tres guiones claros, adaptados a lo que vendes y listos para grabar.">
+  <meta property="og:type" content="website">
+  <meta property="og:title" content="Multiplicador de Reels — 3 guiones listos para grabar">
+  <meta property="og:description" content="Trae un video. Descubre qué funcionó y conviértelo en tres planes de grabación para tu producto, servicio o cuenta.">
