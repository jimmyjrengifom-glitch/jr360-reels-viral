ion": "Mesa de tocador", "shot": "Plano medio de las manos organizando el espacio", "action": "Retira el desorden y coloca una toallita de algodón limpia.", "on_screen": "Menos pasos, mejor resultado"}, {"start": 10, "end": 16, "location": "Mesa de tocador", "shot": "Plano detalle centrado en [nombre de tu crema]", "action": "Presenta el envase en el centro de la mesa destapándolo con cuidado.", "on_screen": "Un solo producto completo"}, {"start": 16, "end": 23, "location": "Mesa de tocador", "shot": "Plano detalle de las manos aplicando producto", "action": "Toma una porción y la distribuye entre las yemas de los dedos de ambas manos.", "on_screen": "Paso 1: limpia | Paso 2: aplica"}, {"start": 23, "end": 30, "location": "Mesa de tocador", "shot": "Plano detalle simulando el masaje", "action": "Muestra el movimiento suave y ascendente de las manos sobre el dorso o antebrazo.", "on_screen": "Paso 3: masaje suave ascendente"}, {"start": 30, "end": 38, "location": "Mesa de tocador", "shot": "Plano detalle de la textura sedosa en la piel", "action": "Muestra el acabado hidratado y el brillo saludable de la zona tratada.", "on_screen": "Ahorra tiempo y dinero cada noche"}, {"start": 38, "end": 45, "location": "Mesa de tocador", "shot": "Plano medio con el reloj de mesa o ambiente nocturno", "action": "Cierra el frasco con un movimiento limpio y preciso.", "on_screen": "Rutina lista en dos minutos"}, {"start": 45, "end": 52, "location": "Mesa de tocador", "shot": "Plano detalle del frasco junto a una pequeña planta o vela decorativa", "action": "Acomoda el producto de frente hacia la cámara.", "on_screen": "Guarda y comparte la rutina"}, {"start": 52, "end": 60, "location": "Mesa de tocador", "shot": "Primer plano fijo del producto", "action": "Muestra el frasco con el texto en pantalla invitando a escribir.", "on_screen": "Escribe QUIERO para más información"}], "caption": "No necesitas diez pasos antes de dormir para tener una piel hidratada y cuidada. Con una fórmula 