-function validateFile(file,maxMb,types,label){
-  if(!file) return true;
-  if(file.size > maxMb * 1024 * 1024){showError(`${label} pesa demasiado. El máximo es ${maxMb} MB.`);return false;}
-  if(!types.includes(file.type)){showError(`${label} no tiene un formato compatible.`);return false;}
-  return true;
-}
