-function mergedScenes(version){
-  const scripts = Array.isArray(version.script) ? version.script : [];
-  const plans = Array.isArray(version.shooting_plan) ? version.shooting_plan : [];
-  const used = new Set();
-  const rows = scripts.map((script,index) => {
-    let planIndex = plans.findIndex((plan,i) => !used.has(i) && String(plan.start) === String(script.start) && String(plan.end) === String(script.end));
-    if(planIndex < 0 && plans[index]) planIndex = index;
-    if(planIndex >= 0) used.add(planIndex);
-    return {...(plans[planIndex] || {}),...script};
-  });
-  plans.forEach((plan,index) => {if(!used.has(index)) rows.push(plan);});
-  return rows;
-}
 
