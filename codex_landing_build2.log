-async function esperarJob(pollUrl){
-  const deadline = Date.now() + 9 * 60 * 1000;
-  const pause = ms => new Promise(resolve => setTimeout(resolve,ms));
-  while(Date.now() < deadline){
-    let data;
-    try{
-      const controller = new AbortController();
-      const timeout = setTimeout(() => controller.abort(),20000);
-      try{
-        const response = await fetch(API_BASE + pollUrl,{signal:controller.signal});
-        data = await response.json();
-      } finally { clearTimeout(timeout); }
-    } catch(error){
-      await pause(5000);
-      continue;
-    }
-    if(data?.error?.code === "JOB_NOT_FOUND"){await pause(5000);continue;}
-    if(data.status === "completed" || data.status === "needs_upload") return data;
-    if(data.status === "failed" || data.ok === false) throw new Error(humanError(data));
-    if(STATUS_TEXT[data.status]) el("progress-text").textContent = STATUS_TEXT[data.status];
-    await pause((Number(data.retry_after_seconds) || 3) * 1000);
-  }
-  throw new Error("El análisis está tardando más de lo normal. Intenta de nuevo en unos minutos.");
-}
