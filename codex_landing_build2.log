start": 24, "end": 31, "voice": "Nota cómo la piel absorbe los nutrientes de [tu ingrediente clave] sin dejar brillo aceitoso.", "on_screen": "Nutrición con [tu ingrediente clave]"}, {"start": 31, "end": 39, "voice": "Pasamos un papel suave por encima y mira: queda completamente limpio y seco.", "on_screen": "Prueba del papel: no mancha"}, {"start": 39, "end": 46, "voice": "Toda la hidratación se queda adentro trabajando mientras descansas.", "on_screen": "Hidratación dentro de tu piel"}, {"start": 46, "end": 53, "voice": "Pásale este video a tu amiga o a tu mamá si todavía sufren con cremas pesadas.", "on_screen": "Reenvíalo a quien le sirva"}, {"start": 53, "end": 60, "voice": "Escríbeme la palabra CREMA por privado y te mando el precio especial y el enlace de compra.", "on_screen": "Escribe CREMA y te paso precio"}], "shooting_plan": [{"start": 0, "end": 4, "location": "Mesa iluminada junto a una ventana en casa", "shot": "Plano cerrado a las manos con el frasco abierto", "action": "Toma un poco de crema con la punta de los dedos y muestra la consistencia a cámara.", "on_screen": "Así debe absorber tu crema nocturna"}, {"start": 4, "end": 10, "location": "Mesa iluminada en casa", "shot": "Plano cenital sobre la mesa", "action": "Muestra una funda de almohada limpia al lado del producto.", "on_screen": "Cero sensación grasosa o pegajosa"}, {"start": 10, "end": 17, "location": "Mesa iluminada en casa", "shot": "Plano detalle de la espátula o dedo sacando crema", "action": "Muestra exactamente la cantidad justa sobre el dorso de la mano.", "on_screen": "Solo necesitas una pequeña porción"}, {"start": 17, "end": 24, "location": "Mesa iluminada en casa", "shot": "Plano detalle en ángulo de 45 grados", "action": "Distribuye con movimientos circulares suaves y parejos.", "on_screen": "Se funde rápido en la piel"}, {"start": 24, "end": 31, "location": "Mesa iluminada en casa", "shot": "Primer plano de la piel hidratada bajo buena luz", "action": "Gira la mano despacio pa