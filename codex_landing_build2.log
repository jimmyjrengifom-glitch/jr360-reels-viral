@@ -0,0 +1,156 @@
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+const root = process.argv[2];
+const web = path.join(root, 'web');
+let failures = 0;
+
+function test(name, fn) {
+  try {
+    fn();
+    console.log(`PASS ${name}`);
+  } catch (error) {
+    failures += 1;
+    console.error(`FAIL ${name}: ${error.message}`);
+  }
+}
+
+function assert(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+function htmlFile(name) {
+  const file = path.join(web, name);
+  assert(fs.existsSync(file), `${name} no existe`);
+  return fs.readFileSync(file, 'utf8');
+}
+
+function inlineScript(html) {
+  const scripts = [...html.matchAll(/<script(?:\s[^>]*)?>([\s\S]*?)<\/script>/gi)];
+  assert(scripts.length > 0, 'no hay JavaScript en línea');
+  return scripts.map(match => match[1]).join('\n');
+}
+
+class ClassList {
+  constructor(classes = '') { this.values = new Set(classes.split(/\s+/).filter(Boolean)); }
+  add(...names) { names.forEach(name => this.values.add(name)); }
+  remove(...names) { names.forEach(name => this.values.delete(name)); }
+  contains(name) { return this.values.has(name); }
+  toggle(name, force) {
+    const active = force === undefined ? !this.contains(name) : Boolean(force);
+    active ? this.add(name) : this.remove(name);
+    return active;
+  }
+}
+
+class ElementStub {
+  constructor(classes = '') {
+    this.classList = new ClassList(classes);
+    this.listeners = {};
+    this.style = { setProperty: (name, value) => { this.style[name] = value; } };
+    this.dataset = {};
+    this.attributes = {};
+    this.innerHTML = '';
+    this.textContent = '';
+    this.value = '';
+    this.files = [];
+    this.childNodes = [{ nodeValue: '' }];
+  }
+  addEventListener(type, fn) { (this.listeners[type] ||= []).push(fn); }
+  dispatch(type, extra = {}) {
+    const event = { target: this, currentTarget: this, preventDefault() {}, ...extra };
+    for (const fn of this.listeners[type] || []) fn(event);
+  }
+  click() { this.dispatch('click'); }
+  focus() {}
+  insertAdjacentHTML(_where, html) { this.innerHTML = html + this.innerHTML; }
+  setAttribute(name, value) { this.attributes[name] = String(value); }
+  getAttribute(name) { return this.attributes[name] ?? null; }
+  querySelectorAll() { return []; }
+  closest() { return null; }
+}
+
+function makeDom(html, hash = '') {
+  const elements = new Map();
+  for (const match of html.matchAll(/<[^>]*\sid=["']([^"']+)["'][^>]*>/gi)) {
+    const tag = match[0];
+    const classMatch = tag.match(/\sclass=["']([^"']*)["']/i);
+    const el = new ElementStub(classMatch?.[1] || '');
+    for (const attr of tag.matchAll(/\s([\w-]+)=["']([^"']*)["']/g)) el.attributes[attr[1]] = attr[2];
+    elements.set(match[1], el);
+  }
+  const documentListeners = {};
+  const windowListeners = {};
+  const observers = [];
+  class ObserverStub {
+    constructor(callback, options) { this.callback = callback; this.options = options; this.targets = []; observers.push(this); }
+    observe(target) { this.targets.push(target); }
+    unobserve() {}
+    disconnect() {}
+  }
+  const document = {
+    body: new ElementStub(),
+    getElementById(id) { if (!elements.has(id)) elements.set(id, new ElementStub()); return elements.get(id); },
+    querySelectorAll(selector) {
+      if (selector === '.reveal') return [...elements.values()].filter(el => el.classList.contains('reveal'));
+      if (selector === '.score-fill') return [...elements.values()].filter(el => el.classList.contains('score-fill'));
+      return [];
+    },
+    addEventListener(type, fn) { (documentListeners[type] ||= []).push(fn); }
+  };
+  const window = {
+    location: { hash },
+    scrollTo() {},
+    open() {},
+    addEventListener(type, fn) { (windowListeners[type] ||= []).push(fn); },
+    dispatchEvent(event) { for (const fn of windowListeners[event.type] || []) fn(event); },
+    matchMedia() { return { matches: false, addEventListener() {} }; }
+  };
+  return { document, window, elements, observers, ObserverStub };
+}
+
+test('app.html abre el ejemplo al cargar #ejemplo', () => {
+  const html = htmlFile('app.html');
+  const dom = makeDom(html, '#ejemplo');
+  const context = {
+    document: dom.document,
+    window: dom.window,
+    location: dom.window.location,
+    navigator: { clipboard: { writeText() {} } },
+    IntersectionObserver: dom.ObserverStub,
+    fetch: async () => ({ ok: true, json: async () => ({}) }),
+    FormData, Blob, URL, setTimeout, clearTimeout, console
+  };
+  vm.runInNewContext(inlineScript(html), context);
+  dom.window.dispatchEvent({ type: 'load' });
+  assert(!dom.elements.get('screen-scripts').classList.contains('hidden'), 'el ejemplo no quedó visible');
+  assert(dom.elements.get('screen-entry').classList.contains('hidden'), 'la pantalla inicial sigue visible');
+});
+
+test('la landing ejecuta el interruptor y configura observadores accesibles', () => {
+  const html = htmlFile('index.html');
+  const dom = makeDom(html);
+  const context = {
+    document: dom.document,
+    window: dom.window,
+    IntersectionObserver: dom.ObserverStub,
+    console
+  };
+  vm.runInNewContext(inlineScript(html), context);
+  const toggle = dom.elements.get('comparison-toggle');
+  assert(toggle, 'falta el interruptor antes/después');
+  toggle.click();
+  assert(toggle.getAttribute('aria-checked') === 'true', 'el interruptor no anuncia el estado después');
+  assert(dom.observers.some(observer => observer.options?.threshold === 0 && typeof observer.options?.rootMargin === 'string'), 'falta IntersectionObserver con threshold 0 y rootMargin');
+});
+
+test('la landing contiene los destinos y metadatos de conversión', () => {
+  const html = htmlFile('index.html');
+  assert(/href=["']app\.html["']/.test(html), 'falta el CTA principal a app.html');
+  assert(/href=["']app\.html#ejemplo["']/.test(html), 'falta el CTA del ejemplo');
+  assert(/property=["']og:title["']/.test(html) && /property=["']og:description["']/.test(html), 'faltan metadatos Open Graph');
+  assert(!/property=["']og:image["']/.test(html), 'og:image no debe incluirse');
+});
+
+if (failures) process.exit(1);
